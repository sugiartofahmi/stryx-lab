---
import { StryxLogo } from "./StryxLogo";
---

<footer class="border-t border-white/[0.08] bg-[#07060b] py-14 w-full px-8 sm:px-14 md:px-24 lg:px-40 xl:px-56 2xl:px-72">
	<div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
		<div class="flex items-center gap-3.5">
			<StryxLogo className="size-6 text-white" />
			<div class="flex flex-col sm:flex-row sm:items-center gap-1.5 sm:gap-3.5">
				<span class="font-sans text-sm font-bold tracking-[0.18em] text-white">
					STRYX LAB
				</span>
				<span class="hidden sm:inline text-zinc-600">·</span>
				<span class="font-mono text-xs text-purple-300 font-medium tracking-wide">
					Born in the dark. Built to endure.
				</span>
			</div>
		</div>

		<div class="font-mono text-xs text-zinc-500">
			© 2026 STRYX LAB.
		</div>
	</div>
</footer>
